@model BARmonica.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Autentificare";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm p-4" style="border-radius: 12px; border: none; background-color: #fcfcfc;">
        <h2 class="text-center mb-4" style="color: #2c3e50; font-weight: bold;">Autentificare</h2>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold text-secondary"></label>
                <input asp-for="Email" class="form-control" placeholder="Email-ul tău" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-bold text-secondary">Parolă</label>
                <input asp-for="Password" class="form-control" placeholder="Parola ta" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted">Ține-mă minte</label>
            </div>

            <button type="submit" class="btn w-100 fw-bold" style="background-color: #2c3e50; color: white; border: none; padding: 10px;">Intră în cont</button>

            <div class="text-center mt-3">
                <a asp-action="Register" class="text-decoration-none" style="color: #d4af37;">Nu ai cont? Creează unul aici.</a>
            </div>
        </form>
    </div>
</div>