@model List<BARmonica.Web.Models.CartItem>
@{
    ViewData["Title"] = "Coșul Tău";
}

<div class="container mt-5">
    <h2 class="mb-4">Coșul tău de cumpărături</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Coșul tău este gol. <a asp-controller="Home" asp-action="Index" class="alert-link">Mergi la cumpărături</a>.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Produs</th>
                    <th>Preț</th>
                    <th>Cantitate</th>
                    <th>Total</th>
                    <th>Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Price.ToString("F2") Lei</td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex">
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" class="form-control form-control-sm" style="width: 70px;" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">Actualizează</button>
                            </form>
                        </td>
                        <td>@((item.Price * item.Quantity).ToString("F2")) Lei</td>
                        <td>
                            <a asp-action="Remove" asp-route-id="@item.ProductId" class="btn btn-danger btn-sm">Șterge</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4>Total de plată: <span class="text-primary">@Model.Sum(x => x.Price * x.Quantity).ToString("F2") Lei</span></h4>
            <a asp-action="Checkout" class="btn btn-premium btn-lg">Finalizează Comanda</a>
        </div>
    }
</div>